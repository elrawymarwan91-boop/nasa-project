generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MissionTemplate {
  id          String        @id
  slug        String        @unique
  title       String
  planet      String
  site        String
  durationSols Int
  configJson  String
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  games       GameSession[]
}

model GameSession {
  id               String          @id
  missionId        String
  guestTokenHash   String          @unique
  status           String
  currentSol       Int
  totalSols        Int
  randomSeed       Int
  stateVersion     Int             @default(0)
  currentStateJson String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mission          MissionTemplate @relation(fields: [missionId], references: [id])
  snapshots        GameSnapshot[]
  actions          PlayerAction[]
  events           GameEvent[]
}

model GameSnapshot {
  id        String      @id
  gameId    String
  sol       Int
  stateJson String
  stateHash String
  createdAt DateTime    @default(now())
  game      GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, sol])
}

model PlayerAction {
  id             String      @id
  gameId         String
  sol            Int
  actionType     String
  payloadJson    String
  status         String
  idempotencyKey String
  createdAt      DateTime    @default(now())
  game           GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, idempotencyKey])
  @@index([gameId, sol])
}

model GameEvent {
  id               String      @id
  gameId           String
  sol              Int
  eventCode        String
  severity         String
  payloadJson      String
  sourceSnapshotId String?
  createdAt        DateTime    @default(now())
  game             GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, sol])
}

model DataSource {
  id             String             @id
  slug           String             @unique
  name           String
  provider       String
  officialUrl    String
  citationText   String
  usageNotes     String
  dataType       String
  updatedAt      DateTime           @updatedAt
  snapshots      NasaDataSnapshot[]
}

model NasaDataSnapshot {
  id             String     @id
  sourceId       String
  externalId     String
  observedAt     DateTime?
  retrievedAt    DateTime
  datasetVersion String?
  unit           String?
  dataJson       String
  qualityFlags   String
  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, observedAt])
}
